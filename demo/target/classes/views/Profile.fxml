<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.its.pa.controllers.ProfileController" styleClass="root">
    
    <VBox spacing="15" alignment="CENTER" styleClass="card" maxWidth="450">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <Label text="MI PERFIL DETALLADO" styleClass="window-title" />
        
        <VBox spacing="5" alignment="CENTER_LEFT" prefWidth="300">
            <Label text="HOBBIES:" styleClass="text-body" style="-fx-font-weight: bold;"/>
            <TextField fx:id="hobbiesField" promptText="Ej. Tejer amigurumis, Anime" />
        </VBox>
        
        <VBox spacing="5" alignment="CENTER_LEFT" prefWidth="300">
            <Label text="INTERESES TÉCNICOS:" styleClass="text-body" style="-fx-font-weight: bold;"/>
            <TextField fx:id="techField" promptText="Ej. JavaFX, C, ESP32" />
        </VBox>
        
        <VBox spacing="5" alignment="CENTER_LEFT" prefWidth="300">
            <Label text="BIOGRAFÍA:" styleClass="text-body" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="bioArea" promptText="Cuéntale a los demás sobre ti..." prefHeight="90" wrapText="true"/>
        </VBox>
        
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
            <Button text="VOLVER" onAction="#goBack" styleClass="btn-secondary" />
            <Button text="GUARDAR CAMBIOS" onAction="#saveProfile" styleClass="btn-primary" />
        </HBox>
    </VBox>
</VBox>