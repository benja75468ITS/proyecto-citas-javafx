<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.its.pa.controllers.ContactController" styleClass="root">
    
    <VBox alignment="CENTER" spacing="20.0" styleClass="card" maxWidth="450">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>

        <Label text="NUEVO CONTACTO" styleClass="window-title" />
        
        <VBox spacing="5" alignment="CENTER_LEFT" prefWidth="300">
            <Label text="MEDIO DE CONTACTO PREFERIDO:" styleClass="text-body" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="contactMethod" promptText="Elige una opción" prefWidth="300" />
        </VBox>
        
        <VBox spacing="5" alignment="CENTER_LEFT" prefWidth="300">
            <Label text="MENSAJE DE PRESENTACIÓN:" styleClass="text-body" style="-fx-font-weight: bold;"/>
            <TextArea fx:id="messageArea" promptText="Escribe un mensaje corto..." prefHeight="100" wrapText="true"/>
        </VBox>
        
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 20 0 0 0;">
            <Button text="CANCELAR" onAction="#goBack" styleClass="btn-secondary" />
            <Button text="ENVIAR MENSAJE" onAction="#sendMessage" styleClass="btn-primary" />
        </HBox>
    </VBox>
</VBox>