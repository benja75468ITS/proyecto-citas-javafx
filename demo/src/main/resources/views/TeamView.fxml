<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.uacam.fi.its.pa.controllers.TeamController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="Acerca del Equipo / Integrantes" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Programación Avanzada - Sistema de Citas" textFill="#7f8c8d">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      
      <!-- Contenedor para la lista de integrantes -->
      <VBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-background-radius: 10;">
         <children>
            <Label text="• Integrante 1: Bryan Ariuel Figueroa Quintal" textFill="#34495e">
               <font><Font size="14.0" /></font>
            </Label>
            <Label text="• Integrante 2: Benjamin Alberto Poot Veloz" textFill="#34495e">
               <font><Font size="14.0" /></font>
            </Label>
            <Label text="• Integrante 3: Royfran Rodrigo Santini Pacheco" textFill="#34495e">
               <font><Font size="14.0" /></font>
            </Label>
            <Label text="• Integrante 4: Jordi Helberto Gomez Gongora" textFill="#34495e">
               <font><Font size="14.0" /></font>
            </Label>
         </children>
      </VBox>

      <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#handleRegresar" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-cursor: hand;" text="Regresar">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
   </children>
</VBox>